<Window x:Class="SystemPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SystemPulse" Height="480" Width="760"
        Background="#1E1F26"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#25262E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8D9C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Image Source="systempulse_logo.png" Width="32" Height="32" Margin="0,0,10,0"/>
            <TextBlock Text="SystemPulse" FontSize="24" FontWeight="Bold"
                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="AlertPanel" Grid.Row="1" Margin="0,6,0,18"/>

        <UniformGrid Grid.Row="2" Rows="1" Columns="3" Margin="0,0,0,20">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="BATTERY HEALTH" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="BatteryHealthText" Text="--%" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="BATTERY CHARGE" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="BatteryChargeText" Text="--%" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="GPU TEMP" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="GpuTempText" Text="--°C" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Expander Grid.Row="3" Header="Show detailed history" Foreground="#8A8D9C"
                   Background="Transparent" BorderThickness="0" VerticalAlignment="Top">
            <Border Background="#25262E" CornerRadius="8" Margin="0,10,0,0">
                <DataGrid x:Name="ReadingsGrid" MaxHeight="220"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#25262E" AlternatingRowBackground="#2A2B34"
                          GridLinesVisibility="None" HeadersVisibility="Column"
                          Foreground="#E4E6EB" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="180"/>
                        <DataGridTextColumn Header="Sensor" Binding="{Binding SensorType}" Width="160"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/>
                        <DataGridTextColumn Header="State" Binding="{Binding SystemState}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Expander>
    </Grid>
</Window>